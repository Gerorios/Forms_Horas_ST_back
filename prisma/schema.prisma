generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ------------------------------------------------------------
// EMPLEADOS (tabla existente en la base)
// ------------------------------------------------------------
model snuempleados {
  codigo            Int
  fecha_nacimiento  DateTime? @db.Date
  fecha_ingreso     DateTime? @db.Date
  legajo            Int       @default(0)
  apellido_nombre   String    @default("") @db.VarChar(70)
  cuil              String    @id @db.Char(13)
  sexo              String    @db.Char(1)
  seccion           String    @db.Char(30)
  categoria         String    @db.Char(30)
  cargo             String    @db.Char(30)
  importe_categoria Decimal?  @db.Decimal(12, 2)
  jornal            String    @db.Char(1)
  domicilio         String    @db.Char(100)
  localidad         String    @db.Char(35)
  provincia         String    @db.Char(35)
  comentario        String    @db.Char(100)
  codigocuadrilla   Int?      @default(0)
  detallecua        String?   @default("") @db.VarChar(30)
  activo            String    @db.Char(1)
  borrado           String?   @default("") @db.Char(1)
  graba             DateTime? @db.Date
  hora              String?   @default("") @db.Char(5)
  usuario           String?   @default("") @db.VarChar(30)

  // Relaciones inversas
  registrosHoras       RegistroHoras[]    @relation("Operario")
  novedades            Novedad[]          @relation("NovedadOperario")
  perfilLiquidacion    PerfilLiquidacion?
  sueldosMensualizados SueldoMensualizado[]
  kmPorTantos          KmPorTantos[]
}

// ------------------------------------------------------------
// PERSONAL / ACCESO
// ------------------------------------------------------------
model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]

  @@map("sth_roles")
}

model Usuario {
  cuil         String  @id @db.Char(13)
  email        String  @unique
  passwordHash String  @map("password_hash")
  rolId        Int     @map("rol_id")
  activo       Boolean @default(true)
  // Permiso puntual (no por rol): habilita a un JefeContrato a cargar el km
  // de "por tantos" (nueva pantalla) y a verla en el nav. Ver ADR-014.
  puedeCargarKmPorTantos Boolean @default(false) @map("puede_cargar_km_por_tantos")

  // Nombre cargado a mano por el Admin, solo se usa para mostrar cuando no
  // hay fila en snuempleados (usuario fuera de nómina). Ver ADR-008.
  nombreFueraNomina String? @map("nombre_fuera_nomina") @db.VarChar(100)

  rol Rol @relation(fields: [rolId], references: [id])
  // Sin FK física a snuempleados a propósito (ver ADR-008): snuempleados se
  // sincroniza desde un sistema externo, y un Usuario puede no tener fila ahí
  // (ej. dueño/socio gerente). El join se resuelve a mano en el código.

  contratosHabilitados  ContratoHabilitado[]
  tiposNovedadHabilitados TipoNovedadHabilitado[]
  contratosComoJefe     ContratoJefe[]
  registrosCargados     RegistroHoras[] @relation("CargadoPor")
  registrosAprobados    RegistroHoras[] @relation("AprobadoPor")
  novedadesCargadas     Novedad[]       @relation("NovedadCargadoPor")
  novedadesAprobadasHys Novedad[]       @relation("NovedadAprobadoHys")
  auditorias            Auditoria[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sth_usuarios")
}

// M:N — el USUARIO que carga tiene habilitados ciertos contratos (no el empleado)
model ContratoHabilitado {
  usuarioCuil String @map("usuario_cuil") @db.Char(13)
  contratoId  Int    @map("contrato_id")

  usuario  Usuario  @relation(fields: [usuarioCuil], references: [cuil])
  contrato Contrato @relation(fields: [contratoId], references: [id])

  @@id([usuarioCuil, contratoId])
  @@map("sth_contratos_habilitados")
}

// M:N — un contrato puede tener varios Jefes de Contrato; cualquiera de ellos
// aprueba/desaprueba/reabre/corrige (el primero que resuelve, resuelve para
// todos). Reemplaza la vieja columna 1:N sth_contratos.jefe_contrato_cuil
// (sigue existiendo en la BD, sin modelar acá, hasta el DROP post-deploy —
// ver ADR-012).
model ContratoJefe {
  contratoId  Int    @map("contrato_id")
  usuarioCuil String @map("usuario_cuil") @db.Char(13)

  contrato Contrato @relation(fields: [contratoId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioCuil], references: [cuil])

  @@id([contratoId, usuarioCuil])
  @@map("sth_contratos_jefes")
}

// M:N — qué tipos de novedad puede cargar cada usuario. Por ahora solo se usa
// para JefeCuadrilla (Supervisor/JefeContrato/Admin no se restringen, ver
// ADR-007); vacío = no puede cargar ninguna novedad.
model TipoNovedadHabilitado {
  usuarioCuil   String @map("usuario_cuil") @db.Char(13)
  tipoNovedadId Int    @map("tipo_novedad_id")

  usuario     Usuario     @relation(fields: [usuarioCuil], references: [cuil])
  tipoNovedad TipoNovedad @relation(fields: [tipoNovedadId], references: [id])

  @@id([usuarioCuil, tipoNovedadId])
  @@map("sth_tipos_novedad_habilitados")
}

// ------------------------------------------------------------
// CATÁLOGOS / ADMINISTRACIÓN
// ------------------------------------------------------------
model Contrato {
  id     Int     @id @default(autoincrement())
  codigo String  @unique
  nombre String
  activo Boolean @default(true)

  jefes                ContratoJefe[]
  tareas               TareaCatalogo[]
  usuariosHabilitados ContratoHabilitado[]
  registrosHoras       RegistroHoras[]
  perfilesImputacion   PerfilContratoImputacion[]

  @@map("sth_contratos")
}

model TareaCatalogo {
  id         Int     @id @default(autoincrement())
  contratoId Int     @map("contrato_id")
  nombre     String
  activo     Boolean @default(true)

  contrato           Contrato                @relation(fields: [contratoId], references: [id])
  registros          RegistroTarea[]
  cargasCombustible  CargaCombustibleTarea[]

  @@map("sth_tareas_catalogo")
}

model Movil {
  id            Int     @id @default(autoincrement())
  identificador String  @unique
  descripcion   String?
  activo        Boolean @default(true)

  registros          RegistroMovil[]
  cargasCombustible  CargaCombustible[]

  @@map("sth_moviles")
}

model Provincia {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  registros          RegistroHoras[]
  cargasCombustible  CargaCombustible[]

  @@map("sth_provincias")
}

model TipoNovedad {
  id                    Int     @id @default(autoincrement())
  nombre                String  @unique
  requiereAprobacionHys Boolean @default(false) @map("requiere_aprobacion_hys")
  generaPlus            Boolean @default(false) @map("genera_plus")
  activo                Boolean @default(true)

  novedades Novedad[]
  habilitaciones TipoNovedadHabilitado[]
  montosPlusVigentes MontoNovedadPlus[]

  @@map("sth_tipos_novedad")
}

// ------------------------------------------------------------
// LIQUIDACIÓN (ver ADR-009)
// ------------------------------------------------------------
enum RegimenLiquidacion {
  jornalizado
  fijo
  // Sueldo bruto fijo cargado a mano por el Liquidador cada quincena (no
  // depende de categoría UOCRA ni de horas). Ver ADR-011.
  mensualizado
  por_tantos
  // Se liquida por otro circuito (fuera de esta app). Categoría UOCRA y
  // modalidad de pago no aplican. Igual queda con PerfilLiquidacion
  // asignado, a diferencia de un administrativo aún no revisado (que
  // simplemente no tiene fila todavía) — ver ADR-009.
  administrativo
}

// Cómo cobra un empleado sus horas extras Y presentismo juntos (no por
// separado): "en B" (sin descuentos, pago informal) o como parte del sueldo
// formal (con descuentos). Es un dato fijo por empleado, no por quincena.
// Renombrado desde "modalidadHoraExtra" — ver ADR-011.
enum ModalidadPago {
  en_b
  con_descuentos
}

// 1:1 con snuempleados (no con Usuario: la mayoría de los empleados no tiene
// login). Un empleado sin fila acá (ej. administrativos) no aparece en el
// panel de Liquidador — exclusión por omisión, ver ADR-009.
model PerfilLiquidacion {
  cuil             String             @id @db.Char(13)
  regimen          RegimenLiquidacion
  categoriaUocraId Int?               @map("categoria_uocra_id")
  modalidadPago    ModalidadPago?     @map("modalidad_pago")
  // Solo tiene sentido con regimen='mensualizado': además del monto fijo,
  // cobra horas extra sobre lo declarado directamente (sin restar nada — lo
  // declarado YA es el excedente sobre su jornal, que nunca se carga). Ver
  // ADR-017.
  permiteHorasExtra Boolean           @default(false) @map("permite_horas_extra")

  empleado  snuempleados    @relation(fields: [cuil], references: [cuil])
  categoria CategoriaUocra? @relation(fields: [categoriaUocraId], references: [id])
  contratosImputacion PerfilContratoImputacion[]

  @@map("sth_perfiles_liquidacion")
}

// M:N — contratos de imputación de un perfil (addendum plan 2026-08-12). Solo
// aplica a regímenes mensualizado/fijo/por_tantos: en el corte por contrato
// del Análisis, el costo del empleado se reparte en partes iguales entre
// estos contratos y sus horas reales se ignoran. Si el régimen cambia, las
// filas se conservan pero dejan de usarse.
model PerfilContratoImputacion {
  cuil       String @map("cuil") @db.Char(13)
  contratoId Int    @map("contrato_id")

  perfil   PerfilLiquidacion @relation(fields: [cuil], references: [cuil])
  contrato Contrato          @relation(fields: [contratoId], references: [id])

  @@id([cuil, contratoId])
  @@map("sth_perfil_contratos_imputacion")
}

model CategoriaUocra {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  tarifas             TarifaCategoriaUocra[]
  perfiles            PerfilLiquidacion[]
  bonosNoRemunerativos BonoNoRemunerativo[]

  @@map("sth_categorias_uocra")
}

// Patrón "tarifa vigente": se toma la fila con vigenteDesde más reciente ≤ la
// fecha de la quincena que se liquida. Se repite igual en MontoNovedadPlus y
// RangoKmPorTantos. (El multiplicador de hora extra es fijo en 1.5, no
// versionado — no todo monto de este dominio necesita esta tabla).
model TarifaCategoriaUocra {
  id               Int      @id @default(autoincrement())
  categoriaUocraId Int      @map("categoria_uocra_id")
  vigenteDesde     DateTime @map("vigente_desde") @db.Date
  importeHora      Decimal  @map("importe_hora") @db.Decimal(12, 2)

  categoria CategoriaUocra @relation(fields: [categoriaUocraId], references: [id])

  @@unique([categoriaUocraId, vigenteDesde])
  @@map("sth_tarifas_categoria_uocra")
}

// Monto por día para TipoNovedad con generaPlus = true (Guardia Pasiva, Viáticos, etc.).
model MontoNovedadPlus {
  id            Int      @id @default(autoincrement())
  tipoNovedadId Int      @map("tipo_novedad_id")
  vigenteDesde  DateTime @map("vigente_desde") @db.Date
  montoPorDia   Decimal  @map("monto_por_dia") @db.Decimal(12, 2)

  tipoNovedad TipoNovedad @relation(fields: [tipoNovedadId], references: [id])

  @@unique([tipoNovedadId, vigenteDesde])
  @@map("sth_montos_novedad_plus")
}

// Régimen "por tantos" (hoy solo relevamiento de fugas, medido en km). Se paga
// todo el total de km al precio del rango en que cae (no progresivo). kmHasta
// null = sin techo (el rango más alto).
// Límites (corregido 2026-08-07, ver CalculoService#buscarRangoKm): NO son
// uniformes. El primer rango (kmDesde más bajo) EXCLUYE su propio kmHasta;
// el/los rango(s) del medio INCLUYEN ambos extremos; el último rango
// (kmHasta null) EXCLUYE su propio kmDesde. Ej. con 0–60 / 60–75 / 75–null:
// 60 y 75 caen en el rango del medio, no en el que "termina"/"empieza" ahí.
model RangoKmPorTantos {
  id           Int      @id @default(autoincrement())
  vigenteDesde DateTime @map("vigente_desde") @db.Date
  kmDesde      Decimal  @map("km_desde") @db.Decimal(8, 2)
  kmHasta      Decimal? @map("km_hasta") @db.Decimal(8, 2)
  precioPorKm  Decimal  @map("precio_por_km") @db.Decimal(12, 2)

  @@map("sth_rangos_km_por_tantos")
}

// Registra qué (mes, año) quedaron efectivamente cargados en la ronda mensual
// de tarifas (categorías UOCRA + montos de novedad con plus + rangos de km +
// bono no remunerativo, todas juntas). Garantiza que nunca haya un mes sin
// resolver explícitamente — ver ADR-010.
model RondaTarifas {
  anio     Int
  mes      Int
  creadaEn DateTime @default(now()) @map("creada_en")

  @@id([anio, mes])
  @@map("sth_rondas_tarifas")
}

enum TipoBonoNoRemunerativo {
  monto_fijo
  porcentaje
}

// Bono extraordinario que UOCRA otorga de vez en cuando, por categoría — no
// cuenta para aguinaldo ni otros cálculos legales. Si es "porcentaje", se
// aplica sobre la tarifa por hora de la categoría (no sobre el básico ya
// multiplicado por horas). Parte de la ronda mensual de tarifas (ADR-010),
// pero opcional: 0 si UOCRA no anunció nada ese mes. Ver ADR-011.
model BonoNoRemunerativo {
  id               Int                    @id @default(autoincrement())
  categoriaUocraId Int                    @map("categoria_uocra_id")
  vigenteDesde     DateTime               @map("vigente_desde") @db.Date
  tipo             TipoBonoNoRemunerativo
  valor            Decimal                @db.Decimal(12, 2)

  categoria CategoriaUocra @relation(fields: [categoriaUocraId], references: [id])

  @@unique([categoriaUocraId, vigenteDesde])
  @@map("sth_bonos_no_remunerativos")
}

// Sueldo bruto "vigente" de un empleado mensualizado — mismo patrón que
// TarifaCategoriaUocra (vigenteDesde siempre día 1 de un mes, se toma la
// fila más reciente ≤ la fecha de la quincena liquidada), pero versionado
// por EMPLEADO en vez de por categoría UOCRA (la categoría no le aplica a
// este régimen). Se gestiona desde Tarifas > Sueldos mensualizados,
// comparte el estado "mes resuelto" con RondaTarifas. Reemplaza a
// MontoMensualizado (clave exacta por quincena, nunca se usó con datos
// reales). Ver ADR-011 y ADR-016.
model SueldoMensualizado {
  id           Int      @id @default(autoincrement())
  cuil         String   @map("cuil") @db.Char(13)
  vigenteDesde DateTime @map("vigente_desde") @db.Date
  monto        Decimal  @db.Decimal(12, 2)

  empleado snuempleados @relation(fields: [cuil], references: [cuil])

  @@unique([cuil, vigenteDesde])
  @@map("sth_sueldos_mensualizados")
}

// Km totales de relevamiento de fugas de un empleado "por tantos" en una
// quincena puntual — el Liquidador lo carga a mano (se mide en otra app, no
// en esta). Ver ADR-009 y ADR-011.
model KmPorTantos {
  cuil     String  @db.Char(13)
  anio     Int
  mes      Int
  quincena Int
  kmTotal  Decimal @map("km_total") @db.Decimal(8, 2)

  empleado snuempleados @relation(fields: [cuil], references: [cuil])

  @@id([cuil, anio, mes, quincena])
  @@map("sth_km_por_tantos")
}

// ------------------------------------------------------------
// TRANSACCIONALES
// ------------------------------------------------------------
enum EstadoRegistro {
  pendiente
  aprobado
  desaprobado
}

model RegistroHoras {
  id                  Int            @id @default(autoincrement())
  loteId              String         @map("lote_id") @db.Char(36)
  fecha               DateTime       @db.Date
  operarioCuil        String         @map("operario_cuil") @db.Char(13)
  cargadoPorCuil      String         @map("cargado_por_cuil") @db.Char(13)
  contratoId          Int            @map("contrato_id")
  horas               Decimal        @db.Decimal(4, 2)
  provinciaId         Int            @map("provincia_id")
  gpsLat              Float?         @map("gps_lat")
  gpsLng              Float?         @map("gps_lng")
  estado              EstadoRegistro @default(pendiente)
  motivoDesaprobacion String?        @map("motivo_desaprobacion") @db.Text
  observacion         String?        @db.Text
  loteIdOrigen        String?        @map("lote_id_origen") @db.Char(36)
  aprobadoPorCuil     String?        @map("aprobado_por_cuil") @db.Char(13)
  aprobadoEn          DateTime?      @map("aprobado_en")
  alertaHoras         Boolean        @default(false) @map("alerta_horas")

  operario    snuempleados  @relation("Operario", fields: [operarioCuil], references: [cuil])
  cargadoPor  Usuario       @relation("CargadoPor", fields: [cargadoPorCuil], references: [cuil])
  aprobadoPor Usuario?      @relation("AprobadoPor", fields: [aprobadoPorCuil], references: [cuil])
  contrato    Contrato      @relation(fields: [contratoId], references: [id])
  provincia   Provincia     @relation(fields: [provinciaId], references: [id])
  moviles     RegistroMovil[]
  tareas      RegistroTarea[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([fecha])
  @@index([operarioCuil, fecha])
  @@index([contratoId, estado])
  @@index([estado, fecha])
  @@index([loteId])
  @@index([loteIdOrigen])
  @@map("sth_registros_horas")
}

model RegistroMovil {
  registroId Int @map("registro_id")
  movilId    Int @map("movil_id")

  registro RegistroHoras @relation(fields: [registroId], references: [id])
  movil    Movil         @relation(fields: [movilId], references: [id])

  @@id([registroId, movilId])
  @@map("sth_registro_moviles")
}

model RegistroTarea {
  registroId Int @map("registro_id")
  tareaId    Int @map("tarea_id")

  registro RegistroHoras @relation(fields: [registroId], references: [id])
  tarea    TareaCatalogo @relation(fields: [tareaId], references: [id])

  @@id([registroId, tareaId])
  @@map("sth_registro_tareas")
}

enum EstadoHys {
  pendiente
  aprobada
  desaprobada
  no_aplica
}

model Novedad {
  id                 Int       @id @default(autoincrement())
  operarioCuil       String    @map("operario_cuil") @db.Char(13)
  tipoNovedadId      Int       @map("tipo_novedad_id")
  fechaInicio        DateTime  @map("fecha_inicio") @db.Date
  fechaFin           DateTime? @map("fecha_fin") @db.Date
  cargadoPorCuil     String    @map("cargado_por_cuil") @db.Char(13)
  justificacionTexto String?   @map("justificacion_texto") @db.Text
  adjuntoUrl         String?   @map("adjunto_url")
  estadoHys          EstadoHys @default(no_aplica) @map("estado_hys")
  aprobadoHysPorCuil String?   @map("aprobado_hys_por_cuil") @db.Char(13)
  aprobadoHysEn      DateTime? @map("aprobado_hys_en")

  operario       snuempleados @relation("NovedadOperario", fields: [operarioCuil], references: [cuil])
  tipoNovedad    TipoNovedad  @relation(fields: [tipoNovedadId], references: [id])
  cargadoPor     Usuario      @relation("NovedadCargadoPor", fields: [cargadoPorCuil], references: [cuil])
  aprobadoHysPor Usuario?     @relation("NovedadAprobadoHys", fields: [aprobadoHysPorCuil], references: [cuil])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([operarioCuil, fechaInicio])
  @@index([tipoNovedadId, estadoHys])
  @@map("sth_novedades")
}

// ------------------------------------------------------------
// COMBUSTIBLE
// ------------------------------------------------------------
enum MedioPagoCombustible {
  cuenta_corriente
  caja
}

enum EstadoCargaCombustible {
  activa
  anulada
}

model EstacionServicio {
  id        Int     @id @default(autoincrement())
  nombre    String  @unique
  localidad String?
  // CUIT del emisor, solo dígitos (11) — identifica la estación en la
  // extracción de tickets con prioridad sobre el nombre. Opcional: las
  // estaciones cargadas antes de esta feature no lo tienen todavía.
  cuit      String? @unique @db.Char(11)
  activo    Boolean @default(true)

  cargas CargaCombustible[]

  @@map("sth_estaciones_servicio")
}

model TipoCombustible {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  cargas  CargaCombustible[]
  aliases TipoCombustibleAlias[]

  @@map("sth_tipos_combustible")
}

// Nombres comerciales tal como vienen impresos en los tickets
// ("INFINIA DIESEL" → Gasoil premium). Los usa la extracción IA para
// matchear cuando el nombre del catálogo no coincide con el impreso.
model TipoCombustibleAlias {
  id                Int    @id @default(autoincrement())
  tipoCombustibleId Int    @map("tipo_combustible_id")
  alias             String @unique

  tipoCombustible TipoCombustible @relation(fields: [tipoCombustibleId], references: [id])

  @@map("sth_tipo_combustible_alias")
}

model CargaCombustible {
  id                Int                    @id @default(autoincrement())
  fechaCarga        DateTime               @map("fecha_carga") @db.Date
  cargadoPorCuil    String                 @map("cargado_por_cuil") @db.Char(13)
  movilId           Int                    @map("movil_id")
  litros            Decimal                @db.Decimal(8, 2)
  monto             Decimal                @db.Decimal(12, 2)
  km                Int
  medioPago         MedioPagoCombustible   @map("medio_pago")
  nroComprobante    String                 @map("nro_comprobante") @db.VarChar(50)
  estacionId        Int                    @map("estacion_id")
  tipoCombustibleId Int                    @map("tipo_combustible_id")
  provinciaId       Int                    @map("provincia_id")
  observaciones     String?                @db.Text
  fotoPath          String                 @map("foto_path") @db.VarChar(255)
  estado            EstadoCargaCombustible @default(activa)
  motivoAnulacion   String?                @map("motivo_anulacion") @db.Text
  anuladaPorCuil    String?                @map("anulada_por_cuil") @db.Char(13)
  anuladaEn         DateTime?              @map("anulada_en")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  movil           Movil                   @relation(fields: [movilId], references: [id])
  estacion        EstacionServicio        @relation(fields: [estacionId], references: [id])
  tipoCombustible TipoCombustible         @relation(fields: [tipoCombustibleId], references: [id])
  provincia       Provincia               @relation(fields: [provinciaId], references: [id])
  tareas          CargaCombustibleTarea[]

  @@index([cargadoPorCuil, fechaCarga])
  @@index([movilId, fechaCarga])
  @@map("sth_cargas_combustible")
}

model CargaCombustibleTarea {
  cargaId Int @map("carga_id")
  tareaId Int @map("tarea_id")

  carga CargaCombustible @relation(fields: [cargaId], references: [id])
  tarea TareaCatalogo    @relation(fields: [tareaId], references: [id])

  @@id([cargaId, tareaId])
  @@map("sth_carga_combustible_tareas")
}

// ------------------------------------------------------------
// AUDITORÍA
// ------------------------------------------------------------
enum AccionAuditoria {
  crear
  editar
  aprobar
  desaprobar
  reabrir
  anular
}

model Auditoria {
  id            Int             @id @default(autoincrement())
  tabla         String
  registroId    Int             @map("registro_id")
  usuarioCuil   String          @map("usuario_cuil") @db.Char(13)
  fecha         DateTime        @default(now())
  accion        AccionAuditoria
  campo         String?
  valorAnterior String?         @map("valor_anterior") @db.Text
  valorNuevo    String?         @map("valor_nuevo") @db.Text

  usuario Usuario @relation(fields: [usuarioCuil], references: [cuil])

  @@index([tabla, registroId])
  @@map("sth_auditoria")
}
