# Copiá este archivo a .env y completá los valores reales.
DATABASE_URL="mysql://usuario:contraseña@host:3306/basededatos"
JWT_SECRET=un_secreto_largo_y_aleatorio
PORT=3001
TICKETS_DIR=./storage/tickets
# Certificados médicos y adjuntos de novedades. En la VPS apunta a una ruta
# ABSOLUTA fuera del repo (como TICKETS_DIR), para que sobreviva a los deploys
# y entre en los backups.
NOVEDADES_ADJUNTOS_DIR=./storage/novedades
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
